# Final HTTPS brand URL. Leave unset on temporary hosting so indexing stays disabled.
NEXT_PUBLIC_SITE_URL=

# Tà Xùa Stay Supabase project only. Never use Biker credentials here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Phase 13B server-only provider credentials. Provider/model selection lives in
# the Admin-controlled allow-listed runtime metadata; no secret is stored there.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Keep the environment master gate disabled until owner-controlled health,
# Prompt Lab and activation are green.
AI_ENABLED=false
AI_KILL_SWITCH=false
AI_ALLOW_PREVIEW=false
AI_IDENTITY_HASH_SALT=

# Server-only shared atomic limiter/budget store. Never use NEXT_PUBLIC_ names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Phase 13D dedicated transcript store. This MUST be a separate Upstash Redis
# database from the quota/budget store above. Logging defaults OFF in its own config.
AI_CONVERSATION_REDIS_REST_URL=
AI_CONVERSATION_REDIS_REST_TOKEN=

# Bounded runtime and spend controls.
AI_PROVIDER_TIMEOUT_MS=12000
AI_REQUEST_TIMEOUT_MS=18000
AI_MAX_OUTPUT_TOKENS=800
AI_PER_IP_PER_MINUTE=8
AI_PER_SESSION_PER_MINUTE=10
AI_GLOBAL_PER_MINUTE=80
AI_DAILY_REQUEST_LIMIT=200
AI_DAILY_BUDGET_USD=3
AI_MONTHLY_BUDGET_USD=30
AI_MAX_REQUEST_COST_USD=0.05
