# Reference checkout (read-only, never part of Stay history)
/.reference/

# dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage/

# Next.js
/.next/
/out/

# production
/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (only the empty template may be committed)
.env*
!.env.example

# Vercel
.vercel/

# Supabase CLI local link/cache metadata
/supabase/.temp/

# TypeScript
*.tsbuildinfo
next-env.d.ts
